# PostgreSQL — shared by Dagster metadata storage and pipeline data
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_HOST=postgresql
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_DB=dagster

# PubMed pipeline data (same PostgreSQL instance, separate DB)
PIPELINE_DB_USER=dagster
PIPELINE_DB_PASSWORD=dagster
PIPELINE_DB_HOST=postgresql
PIPELINE_DB_PORT=5432
PIPELINE_DB_NAME=pubmed_pipeline

# LLM backend
LLM_MODEL=gemini/gemini-2.0-flash-lite
GEMINI_API_KEY=your_key_here

USE_LOCAL_LLM=false
LOCAL_LLM_MODEL=ollama/gemma3:4b
LOCAL_LLM_API_BASE=http://ollama:11434

# PubMed ingestion settings
DATA_DIR=/app/data
PUBMED_BASELINE_URL=https://ftp.ncbi.nlm.nih.gov/pubmed/baseline
# Condition used for filtering (endometriosis is the default)
TARGET_CONDITION=endometriosis
